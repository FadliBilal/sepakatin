# ------------------------------------------------------------------------------
# Alamat publik aplikasi — PERMANEN, TERCETAK DI DOKUMEN & QR CODE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://sepakatin.id

# ------------------------------------------------------------------------------
# Konfigurasi Supabase (Database PostgreSQL, Auth & Storage)
# Dapatkan dari Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# Email Administrator (Server-side Only)
# Dipisahkan koma bila lebih dari satu: admin1@sepakatin.id,admin2@sepakatin.id
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@sepakatin.id

# ------------------------------------------------------------------------------
# Payment Gateway Mayar.id (QRIS & Virtual Account)
# ------------------------------------------------------------------------------
MAYAR_API_URL=https://api.mayar.id/hl/v1
MAYAR_API_KEY=your-mayar-api-key
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret-token

# ------------------------------------------------------------------------------
# Email Transaksional (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Sepakatin <notifikasi@sepakatin.id>"

# ------------------------------------------------------------------------------
# Konfigurasi Operasional & Sandbox
# ------------------------------------------------------------------------------
# Atur "true" HANYA jika ingin membuka tombol simulasi pembayaran di demo panggung/juri
ALLOW_PAYMENT_SIMULATION=false

# Kata sandi akun demo lokal (HANYA pengembangan lokal, KOSONGKAN di produksi)
NEXT_PUBLIC_LOCAL_DEMO_PASSWORD=

# URL publik aplikasi (ganti dengan URL deployment Vercel atau domain Anda)
NEXT_PUBLIC_APP_URL=https://sepakatin.vercel.app

# Konfigurasi Supabase (dapatkan dari Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret untuk API seed demo (opsional)
SEED_SECRET=sepakatin_seed_secret_2026
